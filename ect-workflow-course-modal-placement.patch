+                return SimpleNamespace(field={"magnE_mean": field}, elmdata=[] if surface else [field],
+                                       nodedata=[field] if surface else [], nodes=SimpleNamespace(nr=8),
+                                       elm=SimpleNamespace(nr=8, elm_type=np.full(8, 4), tag1=np.full(8, 2)),

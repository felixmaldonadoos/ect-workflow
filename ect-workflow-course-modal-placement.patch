+                overlay.touch()
+                scan = pipeline.infer_subject_id(path)
+                (fs / scan / "mri").mkdir(parents=True, exist_ok=True)
+                for name in ["aparc+aseg.mgz", "aparc.a2009s+aseg.mgz"]:
+                    (fs / scan / "mri" / name).touch()
+
+            def mesh(path: str, *args, surface: bool = False):
+                if surface:

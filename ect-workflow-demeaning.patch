+    else:
+        if not isinstance(parcel_mean_e, pd.DataFrame):
+            raise TypeError("parcel_mean requires parcel_mean_e as a pandas DataFrame")
+        _require_matching_labels(parcel_mean_e.index, parcels.index, "parcel_mean_e scans")

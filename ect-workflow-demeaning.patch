+                             "cumulative_variance_ratio": np.cumsum(model.explained_variance_ratio_)},
+                            index=pd.Index(names, name="component"))
+    return DemeanedParcelPCA(parcels, reference, demeaned, demean_by, scores, loadings, variance, model)
